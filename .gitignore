# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

/dist/
/.local/
/contracts/out/
/contracts/cache/
!.env.example

/.private/

# Separate local production workspaces; not part of the deployed application.
/video/
/pitch/

# Local agent tooling and downloaded design references.
/.agents/
/skills-lock.json
/docs/design/references/*.png

# Machine-specific deployment bookkeeping (public receipts remain tracked).
/deployments/anvil.json
/deployments/*.activation.json
/deployments/*.pending.json
/deployments/*.plan.json

# Editor / Python / OS caches and credential material.
__pycache__/
*.pyc
*.key
*.p12
*.pfx
.idea/
.vscode/

# Local, reproducible case evidence; source tooling lives in demo/.
/demo-artifacts/
