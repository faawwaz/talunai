[Unit]
Description=Talunai agent and blockchain worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=talunai
Group=talunai
WorkingDirectory=/opt/talunai-worker/current
EnvironmentFile=/etc/talunai/worker.env
Environment=NODE_ENV=production
Environment=PATH=/opt/talunai-worker/runtime/node-v24.18.0-linux-x64/bin:/usr/bin:/bin
ExecStart=/opt/talunai-worker/runtime/node-v24.18.0-linux-x64/bin/node --max-old-space-size=384 dist/worker/main.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=35
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
StateDirectory=talunai-worker
StateDirectoryMode=0750
ReadWritePaths=/var/lib/talunai-worker
MemoryMax=768M
TasksMax=64
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=talunai-worker

[Install]
WantedBy=multi-user.target
