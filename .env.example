# Template only. Run npm run local:init for local random secrets and deploy:local for real addresses.
NODE_ENV=development
APP_ENV=local
DATABASE_URL=postgres://talunai:talunai-local-only@127.0.0.1:55432/talunai
# Cloud: session pooler port 5432 with a verified provider CA (base64 PEM).
# Omit sslmode URL parameters when supplying the explicit CA below.
# DATABASE_SSL_CA_BASE64=
# DATABASE_POOL_MAX=1
# DATABASE_ORM_POOL_MAX=1
# WORKER_DATABASE_POOL_MAX=5
APP_ORIGIN=http://localhost:3000
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
# Public Reown Project ID for RainbowKit mobile wallet / QR connections.
# Set this in Vercel before building. Without it, browser wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
SESSION_SECRET=replace-with-at-least-32-random-secret-characters
CLAIM_ID_HMAC_KEY=replace-with-at-least-32-random-secret-characters
CLAIM_ID_HMAC_KEY_VERSION=1
CHAIN_ID=31337
RPC_HTTP_URL=http://127.0.0.1:8545
RPC_FALLBACK_HTTP_URL=
CHAIN_CONFIRMATIONS=1
INDEXER_RESCAN_BLOCKS=20
# Actual deployment output. Never invent these.
CONTRACT_REGISTRY_ADDRESS=
CONTRACT_VAULT_ADDRESS=
CONTRACT_AGENT_EXECUTOR_ADDRESS=
MOCK_IDR_ADDRESS=
DEPLOYMENT_START_BLOCK=
# Worker only. Generated public test account ONLY on chain 31337; private test-only key on chain97.
AGENT_PRIVATE_KEY=
LLM_MODE=mock
# Worker only; no key needed in mock. Live startup fails if absent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-flash-02-23
DOCUMENT_STORAGE_DRIVER=filesystem
DOCUMENT_STORAGE_ROOT=./.local/documents
# Cloud: DOCUMENT_STORAGE_DRIVER=supabase, private bucket only.
# Server/worker secrets, NEVER NEXT_PUBLIC_*.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=talunai-documents
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=20
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=30000
# Deployment CLI only, chain97 only; never pass these to API/worker containers.
# DEMO_ADMIN_PRIVATE_KEY=
# DEMO_VERIFIER_PRIVATE_KEY=
# AGENT_ADDRESS=  # Public address derived from worker key; no agent key needed in deployment env.
# DEMO_BORROWER_PRIVATE_KEY=
# DEMO_BUYER_PRIVATE_KEY=
# DEMO_LENDER_PRIVATE_KEY=
# SEED_ADMIN_ADDRESS=
# SEED_VERIFIER_ADDRESS=
# SEED_BORROWER_ADDRESS=
# SEED_BUYER_ADDRESS=
# SEED_LENDER_ADDRESS=
# SEED_LENDERTWO_ADDRESS=
